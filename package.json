{
  "name": "augg-tarot-queue",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/patch-prisma.js && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/patch-prisma.js && tsx --test tests/**/*.test.ts",
