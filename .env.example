# Database configuration (SQLite for local, PostgreSQL for Supabase / production)
DATABASE_URL="file:./dev.db"

# JWT Secret for admin session cookies
JWT_SECRET="replace_with_a_long_random_secret_minimum_32_characters"

# Base Application URL (used for generating customer tracking links)
