# Database configuration (SQLite for local development, PostgreSQL for Supabase / production)
DATABASE_URL="file:./dev.db"

# JWT Secret for admin session cookies
# CRITICAL SECURITY REQUIREMENT:
# - Must be a strong, cryptographically secure random string of at least 32 characters.
# - NEVER commit your actual JWT_SECRET or .env file to Git!
# Generate a secure secret using one of these commands:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_a_secure_random_string_of_at_least_32_characters"

# Base Application URL (used for generating customer tracking links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shop branding
NEXT_PUBLIC_SHOP_NAME="Magical Pastel Tarot 🔮"

# Tracking Token TTL Policy
# Number of days before customer queue tracking links expire.
# Omit or set to 0 for tokens that never expire (default behavior).
# TRACKING_TOKEN_TTL_DAYS="30"

# Initial Production Bootstrap Account (Required when seeding fresh database in production)
# If provided, prisma/seed.js will initialize the owner account with these credentials.
# Existing accounts will NEVER be overwritten or have their passwords changed on re-seed.
# INITIAL_OWNER_EMAIL="owner@yourshop.com"
# INITIAL_OWNER_PASSWORD="Set_A_Strong_Random_Password_Here"
# INITIAL_OWNER_NAME="Shop Owner"

# Development Seed Options (Only active when NODE_ENV="development")
# Explicitly enables seeding default development accounts (owner@magicaltarot.com)
ENABLE_DEFAULT_DEV_ACCOUNTS="true"
# Explicitly enables seeding sample mock queues for development testing
SEED_DEMO_DATA="true"

# Demo Database Reset Confirmation (Strict double guard required for scripts/reset-demo-db.js)
# CONFIRM_DEMO_RESET="true"
